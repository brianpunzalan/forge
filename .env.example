# Forge control plane
PORT=3000
FORGE_DATA_DIR=.forge
FORGE_SESSION_DIR=.forge/sessions

# Postgres (matches docker-compose.yml). Leave empty to use the in-memory store.
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# Shared token protecting the chat API. Empty = no auth (local loopback only).
FORGE_AUTH_TOKEN=

# Session lifecycle
FORGE_IDLE_TTL_MS=900000
FORGE_MAX_SESSIONS=3
FORGE_VM_RESPAWN_RETRIES=2

# Per-session preview proxy port range
FORGE_PREVIEW_PORT_START=4100
FORGE_PREVIEW_PORT_END=4500

# Model selection: <provider>/<model>. Pi resolves this at boot.
# DeepSeek examples: deepseek/deepseek-v4-flash (fast), deepseek/deepseek-v4-pro (strong).
FORGE_MODEL=deepseek/deepseek-v4-flash

# BYOK model credentials (pick your provider). Read by Pi's ModelRuntime.
DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
